# Admin signup token (used to create first admin account)
ADMIN_SIGNUP_TOKEN=change-me-to-a-strong-random-token

# VDP SMTP settings (optional — for vulnerability disclosure notifications)
VDP_SMTP_HOST=
VDP_SMTP_PORT=1025
VDP_SMTP_USER=
VDP_SMTP_PASS=
VDP_FROM_EMAIL=noreply@antcrowd.local

# Auth service email provider: "brevo" (production) or "mailpit" (local dev)
AUTH_EMAIL_PROVIDER=mailpit

# Brevo SMTP (production) — get from https://app.brevo.com → SMTP & API
AUTH_SMTP_HOST=smtp-relay.brevo.com
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=your_brevo_smtp_user@smtp-brevo.com
AUTH_SMTP_PASS=your_brevo_smtp_password
AUTH_SMTP_FROM=AntCrowd Security <noreply@yourdomain.com>

# Mailpit (local dev only)
AUTH_MAILPIT_HOST=mailpit
AUTH_MAILPIT_PORT=1025

# Email verification settings
AUTH_EMAIL_VERIFICATION_MINUTES=10
AUTH_EMAIL_VERIFICATION_CODE_LENGTH=6
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
