DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/training_service

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

CORS_ORIGINS=http://localhost:5273,http://localhost:5274,http://localhost:5275

# Initial admin account (change before first run)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change_this_strong_password
