NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5545
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=your_db_password_here

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
TWO_FACTOR_ENCRYPTION_SECRET=your_2fa_encryption_secret_here

# Session cookie
COOKIE_NAME=antcrowd_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# URLs
FRONTEND_BASE_URL=http://localhost:8089
CORS_ORIGINS=http://localhost:5173,http://localhost:8089

# Email verification settings
EMAIL_VERIFICATION_MINUTES=10
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Email provider: "brevo" (production) or "mailpit" (local dev)
EMAIL_PROVIDER=mailpit

# Brevo SMTP (production) — get credentials from https://app.brevo.com → SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_user@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM=YourApp <noreply@yourdomain.com>

# Mailpit (local dev only)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
