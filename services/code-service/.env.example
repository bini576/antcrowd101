# Server
ADDR=:8080
CORS_ORIGIN=http://localhost:5173

# Postgres
POSTGRES_USER=code_service
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=code_service
DATABASE_URL=postgres://code_service:your_db_password_here@localhost:5432/code_service?sslmode=disable

# SMTP (optional — for security alerts)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASS=your-password
SMTP_FROM=alerts@yourdomain.com
SMTP_TO=security@yourdomain.com
